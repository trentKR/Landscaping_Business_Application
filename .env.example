# Clips Admin — environment variables
#
# The app reads these from the process environment; it does not load a .env
# file itself. On a server, copy this to /etc/clips/env and point the systemd
# unit's EnvironmentFile= at it (see docs/deployment.md). Locally, `python app.py`
# runs in development mode and needs none of them.
#
# Keep comments on their own lines: systemd treats anything after `=` as the value.

# --- Core (required in production) -------------------------------------------
APP_ENV=production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Uncomment only for an HTTP-only test box
#SESSION_COOKIE_SECURE=false

# --- First-boot admin (used only while the users table is empty) -------------
ADMIN_USERNAME=admin
# At least 12 characters
ADMIN_PASSWORD=

# --- Public URLs ---------------------------------------------------------------
# Links in emails sent from background threads
BASE_URL=https://admin.example.com
# Linked in invoice emails
MARKETING_URL=https://www.example.com
# Landing-page quote requests are emailed here
QUOTE_INBOX=quotes@example.com

# --- Email: Gmail OAuth2 (preferred) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Email: SMTP fallback ------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Your Business <noreply@example.com>

# --- Stripe (customer portal payments) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Printed on invoices and the landing page ----------------------------------
# Check payee
PAYMENT_NAME=
VENMO_HANDLE=
CASHAPP_HANDLE=
ZELLE_PHONE=
BUSINESS_PHONE=
BUSINESS_STREET=
BUSINESS_CITY_STATE_ZIP=
